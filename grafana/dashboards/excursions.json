      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT f.measured_at AS time, f.value AS \"value\" FROM marts.fct_measurements AS f JOIN excursions_ground_truth AS e ON e.chamber_id = f.chamber_id AND e.parameter_id = f.parameter_id WHERE e.excursion_id = $excursion AND f.source = 'sensor' AND $__timeFilter(f.measured_at) ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT a.measured_at AS time, f.value AS \"EWMA/CUSUM alarm\" FROM marts.fct_spc_alarms AS a JOIN excursions_ground_truth AS e ON e.chamber_id = a.chamber_id AND e.parameter_id = a.parameter_id JOIN marts.fct_measurements AS f ON f.source = 'sensor' AND f.wafer_id = a.wafer_id AND f.route_step_id = a.route_step_id AND f.pass_no = a.pass_no AND f.parameter_id = a.parameter_id WHERE e.excursion_id = $excursion AND a.scope = 'chamber' AND a.chart_family = 'memory' AND $__timeFilter(a.measured_at) GROUP BY 1, 2 ORDER BY 1",
          "refId": "B"
        }
      ],
      "title": "The excursion's sensor: value and EWMA/CUSUM alarms",
      "type": "timeseries"
    },
