          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT suspect_rank AS rank, suspect, round(lift::numeric, 2) AS lift, round(chi2::numeric, 1) AS chi2, CASE WHEN is_true_cause THEN 'true cause' ELSE '' END AS truth FROM marts.fct_root_cause_candidates WHERE excursion_id = $excursion AND signal = 'yield' ORDER BY suspect_rank LIMIT 15",
