          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '1 day', y.tested_at) AS time, p.product_code AS metric, avg(y.yield_pct) AS yield FROM marts.fct_wafer_yield AS y JOIN marts.dim_product AS p ON p.product_id = y.product_id WHERE $__timeFilter(y.tested_at) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Daily mean yield by product",
      "type": "timeseries"
