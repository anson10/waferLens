{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "The FabEye classifier as a service: volume by pattern, review queue, latency and errors, scraped by Prometheus.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "tags": [
        "waferlens"
      ],
      "title": "WaferLens",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "Prometheus extrapolates increase() to the range edges: an estimate, a few percent off the exact count.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(predictions_total[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Wafers classified",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "Share of wafers below FabEye's auto-accept confidence: the engineer's review queue.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(auto_accept_total{decision=\"review\"}[$__range])) / sum(increase(auto_accept_total[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Sent to review",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/predict/batch\"}[$__range])))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "p95 latency per batch of 64",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "Non-2xx responses. No failing request yet means no series: 0.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 2,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(increase(http_requests_total{status!~\"2..\"}[$__range])) or vector(0)) / sum(increase(http_requests_total[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failed requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (pattern) (rate(predictions_total{pattern!=\"none\"}[2m])) * 60",
          "instant": false,
          "legendFormat": "{{pattern}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Predictions per minute by pattern (excluding 'none')",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/predict/batch\"}[2m])))",
          "instant": false,
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/predict/batch\"}[2m])))",
          "instant": false,
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Batch latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "A rising review share means the maps look less like FabEye's calibration lots: a domain-shift early warning.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 7,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(auto_accept_total{decision=\"review\"}[5m])) / sum(rate(auto_accept_total[5m]))",
          "instant": false,
          "legendFormat": "review share",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Review rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "waferlens-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "waferlens-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (path) (rate(http_requests_total[2m]))",
          "instant": false,
          "legendFormat": "{{path}}",
