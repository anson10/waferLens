          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('10 seconds', detected_at) AS time, count(*) AS \"ewma\" FROM stream_alarms WHERE chart = 'ewma' AND $__timeFilter(detected_at) GROUP BY 1 ORDER BY 1",
