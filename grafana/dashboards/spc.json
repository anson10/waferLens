          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT a.measured_at AS time, a.statistic AS \"T\u00b2\", l.t2_limit AS \"limit\" FROM marts.fct_spc_alarms AS a JOIN spc_control_limits AS l ON l.limit_id = a.limit_id WHERE a.chart = 't2' AND a.chamber_id = $chamber AND $__timeFilter(a.measured_at) ORDER BY 1",
