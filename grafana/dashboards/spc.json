            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS time, mean_value AS \"mean\", mean_value + sd_value AS \"+1 sd\", mean_value - sd_value AS \"-1 sd\" FROM sensor_daily WHERE chamber_id = $chamber AND parameter_id = $parameter AND $__timeFilter(day) ORDER BY 1",
          "refId": "A"
