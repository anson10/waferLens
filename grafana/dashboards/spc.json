          "rawQuery": true,
          "rawSql": "SELECT a.measured_at AS time, a.chart, a.direction, round(a.statistic::numeric, 2) AS statistic, a.wafer_id AS wafer, a.route_step_id AS \"route step\" FROM marts.fct_spc_alarms AS a WHERE a.scope = 'chamber' AND a.chamber_id = $chamber AND a.parameter_id = $parameter AND $__timeFilter(a.measured_at) ORDER BY a.measured_at DESC LIMIT 200",
