          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT importance_rank AS rank, 's' || lpad(sensor_no::text, 3, '0') AS sensor, round((100 * importance / sum(importance) OVER ())::numeric, 1) AS \"share of importance %\", round(missing_pct::numeric, 1) AS \"missing in training %\" FROM secom_sensor_importance ORDER BY importance_rank LIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Sensors behind the scores",
      "type": "table"
