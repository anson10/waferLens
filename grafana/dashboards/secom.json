      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.run_time AS time, s.score AS \"pass\" FROM secom_scores AS s JOIN secom_runs AS r USING (run_id) WHERE NOT r.failed AND $__timeFilter(r.run_time) ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.run_time AS time, s.score AS \"fail\" FROM secom_scores AS s JOIN secom_runs AS r USING (run_id) WHERE r.failed AND $__timeFilter(r.run_time) ORDER BY 1",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t AS time, alarm_threshold AS \"threshold (10% false alarms in training)\" FROM secom_model_versions, unnest(ARRAY[$__timeFrom()::timestamptz, $__timeTo()::timestamptz]) AS t ORDER BY 1",
          "refId": "C"
        }
      ],
      "title": "Out-of-sample fail score per run",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "waferlens-timescaledb"
      },
      "description": "Fail rate over every run; alarm rate over scored runs. The fail rate drifts, so a threshold from the training period no longer gives the false-alarm rate it was set for.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 8,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "waferlens-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', r.run_time) AS time, 100 * avg(r.failed::int) AS \"fail rate\", 100 * avg(s.alarm::int) AS \"alarm rate\" FROM secom_runs AS r LEFT JOIN secom_scores AS s USING (run_id) WHERE $__timeFilter(r.run_time) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Weekly fail rate vs alarm rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "waferlens-timescaledb"
      },
