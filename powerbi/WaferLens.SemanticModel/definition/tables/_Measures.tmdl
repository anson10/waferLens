table _Measures
	lineageTag: 6524a9f4-1631-4a16-85b6-81a73c435c94

	/// Number of wafers that reached wafer sort
	measure 'Wafers Sorted' = COUNTROWS ( fct_wafer_yield )
		formatString: #,0
		displayFolder: Yield
		lineageTag: 71fbd49b-3f85-43f1-80d8-c585abe3330e

		annotation PBI_FormatHint = {"isCustom":true}

	/// Dies tested at wafer sort
	measure 'Tested Dies' = SUM ( fct_wafer_yield[tested_dies] )
		formatString: #,0
		displayFolder: Yield
		lineageTag: 5e972c77-caf1-40ce-84ef-6d47bb8fd380

		annotation PBI_FormatHint = {"isCustom":true}

	/// Dies that passed wafer sort
	measure 'Good Dies' = SUM ( fct_wafer_yield[good_dies] )
		formatString: #,0
		displayFolder: Yield
		lineageTag: f485f9c9-f15a-49c9-a717-1bde48346736

		annotation PBI_FormatHint = {"isCustom":true}

	/// Good dies ÷ tested dies: die-weighted yield, the number a fab reports
	measure 'Die Yield %' = DIVIDE ( [Good Dies], [Tested Dies] )
		formatString: 0.00%
		displayFolder: Yield
		lineageTag: 6c1816a1-3eed-47b6-a6d2-7d1e8a991dfb

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average of each wafer's yield; weights every wafer equally, whatever its die count
	/// 
	measure 'Avg Wafer Yield %' = AVERAGE ( fct_wafer_yield[yield_pct] ) / 100
		formatString: 0.00%
		displayFolder: Yield
		lineageTag: 37b0a8d5-de39-4ea1-af34-8349a68df432

		annotation PBI_FormatHint = {"isCustom":true}

	/// Dies that failed wafer sort (all failing bins)
	measure 'Failed Dies' =
			
			CALCULATE (
			    SUM ( fct_die_bins[die_count] ),
			    dim_sort_bin[is_pass] = FALSE ()
			)
		formatString: #,0
		displayFolder: Loss
		lineageTag: 337d7ca5-f162-4ebd-83cf-a1afc14c29f5

		annotation PBI_FormatHint = {"isCustom":true}

	/// This bin's share of all failed dies.
	measure 'Loss Share %' =
			
			DIVIDE (
			    [Failed Dies],
			    CALCULATE ( [Failed Dies], REMOVEFILTERS ( dim_sort_bin ) )
			)
		formatString: 0.0%
		displayFolder: Loss
		lineageTag: dcd7e8ce-6d85-408f-82ca-bb79c9042394

		annotation PBI_FormatHint = {"isCustom":true}

	/// Number of SPC alarms raised, at chamber and tool scope
	measure 'SPC Alarms' = COUNTROWS ( fct_spc_alarms )
		formatString: #,0
		displayFolder: Process Control
		lineageTag: d2e4e2f3-0f77-4b35-82e1-c280f2cc733f

		annotation PBI_FormatHint = {"isCustom":true}

	/// SPC alarms raised on chamber-level charts only
	measure 'Chamber Alarms' = CALCULATE ( [SPC Alarms], fct_spc_alarms[scope] = "chamber" )
		formatString: #,0
		displayFolder: Process Control
		lineageTag: bde919cb-6209-4c9e-ad5b-7fdf0887dce7

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average hours until the EWMA chart caught an excursion (chamber scope, detected, after the baseline)
	measure 'Mean Detection Delay (h)' =
			
			CALCULATE (
			    AVERAGE ( fct_excursion_detection[delay_hours] ),
			    fct_excursion_detection[chart] = "ewma",
			    fct_excursion_detection[scope] = "chamber",
			    fct_excursion_detection[detected] = TRUE (),
			    fct_excursion_detection[started_in_baseline] = FALSE ()
			)
		formatString: 0.0
		displayFolder: Process Control
		lineageTag: 87775988-4a0f-4513-96a2-a56ba456a620

		annotation PBI_FormatHint = {"isCustom":true}

	/// Number of injected excursions
	measure Excursions = COUNTROWS ( dim_excursion )
		formatString: #,0
		displayFolder: Root Cause
		lineageTag: ae236288-357f-4912-be9f-137b269099bd

		annotation PBI_FormatHint = {"isCustom":true}

	/// Excursions that cost yield where commonality ranked the true cause first
	measure 'Root Cause Top-1 %' =
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fct_root_cause_eval ),
			        fct_root_cause_eval[top1] = TRUE (),
			        fct_root_cause_eval[cost_yield] = TRUE ()
			    ),
			    CALCULATE (
			        COUNTROWS ( fct_root_cause_eval ),
			        fct_root_cause_eval[cost_yield] = TRUE ()
			    )
			)
		formatString: 0.0%
		displayFolder: Root Cause
		lineageTag: eb4520f1-54b7-4094-aca6-d769e81c892f

		annotation PBI_FormatHint = {"isCustom":true}

	/// Spatial excursions where pattern-led commonality ranked the true chamber first
	measure 'Pattern-led Top-1 %' =
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fct_root_cause_eval ),
			        fct_root_cause_eval[pattern_true_rank] = 1
			    ),
			    CALCULATE (
			        COUNTROWS ( fct_root_cause_eval ),
			        NOT ISBLANK ( fct_root_cause_eval[pattern_true_rank] )
			    )
			)
		formatString: 0.0%
		displayFolder: Root Cause
		lineageTag: c460d124-5181-4521-9af4-e4e07122d8fc

		annotation PBI_FormatHint = {"isCustom":true}

	/// Wafers FabEye sent to human review (low confidence)
	measure 'Review Rate %' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fct_wafer_pattern ), fct_wafer_pattern[needs_review] = TRUE () ),
			    COUNTROWS ( fct_wafer_pattern )
			)
		formatString: 0.0%
		displayFolder: Wafer Patterns
		lineageTag: 20399b6d-490a-4499-9666-0c7a64df8119

		annotation PBI_FormatHint = {"isCustom":true}

	/// Wafers where FabEye's predicted pattern equals the true pattern
	measure 'Pattern Accuracy %' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fct_wafer_pattern ), fct_wafer_pattern[is_correct] = TRUE () ),
			    COUNTROWS ( fct_wafer_pattern )
			)
		formatString: 0.0%
		displayFolder: Wafer Patterns
		lineageTag: 2cc8e214-eec9-490e-8721-c0c4611323bf

		annotation PBI_FormatHint = {"isCustom":true}

	/// Wafers counted by FabEye's predicted pattern
	measure 'Wafers (predicted)' = COUNTROWS ( fct_wafer_pattern )
		formatString: #,0
		displayFolder: Wafer Patterns
		lineageTag: 7febdd68-c5d6-41bf-aa41-95d5fec66c75

		annotation PBI_FormatHint = {"isCustom":true}

	/// Wafers counted by their true pattern (uses the inactive relationship)
	measure 'Wafers (true)' =
			
			CALCULATE (
			    COUNTROWS ( fct_wafer_pattern ),
			    USERELATIONSHIP ( fct_wafer_pattern[true_pattern], wafer_pattern_classes[pattern] )
			)
		formatString: #,0
		displayFolder: Wafer Patterns
		lineageTag: 0095322a-4b90-48a9-89f6-b726defd80ff

		annotation PBI_FormatHint = {"isCustom":true}

	/// Die yield in the previous ISO week
	measure 'Die Yield % PW' =
			
			VAR ThisWeek = MIN ( dim_date[week_start] )
			RETURN
			    CALCULATE (
			        [Die Yield %],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[week_start] = ThisWeek - 7
			    )
		formatString: 0.00%
		displayFolder: Yield
		lineageTag: cd6d3900-2adf-4122-a08c-bad40e2c0c18

		annotation PBI_FormatHint = {"isCustom":true}

	/// Change in die yield vs the previous week, in percentage points
	measure 'Yield Δ WoW (pp)' =
			
			IF (
			    NOT ISBLANK ( [Die Yield % PW] ),
			    ( [Die Yield %] - [Die Yield % PW] ) * 100
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: Yield
		lineageTag: 90e04f57-ab33-4152-8ce1-b54d7d473925

		annotation PBI_FormatHint = {"isCustom":true}

	/// Die yield in the previous month
	measure 'Die Yield % PM' =
			
			CALCULATE (
			    [Die Yield %],
			    DATEADD ( dim_date[calendar_date], -1, MONTH )
			)
		formatString: 0.00%
		displayFolder: Yield
		lineageTag: 3ac36328-10b9-483a-a8a8-c37b04ab9a1d

		annotation PBI_FormatHint = {"isCustom":true}

	/// Change in die yield vs the previous month, in percentage points
	measure 'Yield Δ MoM (pp)' =
			
			IF (
			    NOT ISBLANK ( [Die Yield % PM] ),
			    ( [Die Yield %] - [Die Yield % PM] ) * 100
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: Yield
		lineageTag: 85a16d98-f7ca-4855-9fdf-edaf934e854f

		annotation PBI_FormatHint = {"isCustom":true}

	/// Dies lost to injected excursions, versus same-window control wafers
	measure 'Dies Lost to Excursions' = SUM ( fct_excursion_impact[dies_lost] )
		formatString: #,0
		displayFolder: Loss
		lineageTag: daf7278b-2325-4bb1-bf09-c744a94823b8

		annotation PBI_FormatHint = {"isCustom":true}

	/// Running share of failed dies, largest bin first (Pareto)
	measure 'Cumulative Loss %' =
			
			VAR ThisBin = [Failed Dies]
			VAR Bins =
			    ADDCOLUMNS (
			        ALLSELECTED ( dim_sort_bin[bin_name] ),
			        "@lost", [Failed Dies]
			    )
			RETURN
			    DIVIDE (
			        SUMX ( FILTER ( Bins, [@lost] >= ThisBin ), [@lost] ),
			        SUMX ( Bins, [@lost] )
			    )
		formatString: 0.0%
		displayFolder: Loss
		lineageTag: 6b3bc245-3e09-4b4a-add8-37ff0ebca679

		annotation PBI_FormatHint = {"isCustom":true}

	/// Rank commonality gave the injected true cause, for the selected excursion
	measure 'True Cause Rank' = SELECTEDVALUE ( fct_root_cause_eval[true_rank] )
		formatString: 0
		displayFolder: Root Cause
		lineageTag: 5a61788d-4da4-4e7e-8ec8-0f19b5711f24

		annotation PBI_FormatHint = {"isCustom":true}

	/// Background colour for the true cause's row in a candidates table
	measure 'Cause Color' = IF ( SELECTEDVALUE ( fct_root_cause_candidates[is_true_cause] ) = TRUE (), "#C8E6C9" )
		displayFolder: Root Cause
		lineageTag: 45fbfb9b-2467-4f84-9b32-ce56b23258fa

	/// FabEye's pattern for one wafer (blank for unsorted wafers, so they drop out of tables)
	measure 'Predicted Pattern' = SELECTEDVALUE ( fct_wafer_pattern[predicted_pattern] )
		displayFolder: Wafer Patterns
		lineageTag: bbcb0b11-e705-4922-b120-ff54f7131a50

	/// FabEye's confidence in the pattern of one wafer
	measure 'Pattern Confidence' = SELECTEDVALUE ( fct_wafer_pattern[confidence] )
		formatString: 0.0%
		displayFolder: Wafer Patterns
		lineageTag: 563d42f2-b6c9-41a2-ae85-e013975cb750

		annotation PBI_FormatHint = {"isCustom":true}

	/// Title for the wafer drillthrough page
	measure 'Wafer Title' = "Wafer " & SELECTEDVALUE ( dim_wafer[wafer_code], "(none)" )
		displayFolder: Wafer Patterns
		lineageTag: 5dea4ffa-edb1-4346-b0a6-bc2125e26c61

	/// Chamber of the hovered suspect (or chamber) row, for the chamber tooltip
	measure 'Tip Chamber' =
			CALCULATE (
			    SELECTEDVALUE ( dim_chamber[chamber_label] ),
			    TREATAS ( VALUES ( fct_root_cause_candidates[chamber_id] ), dim_chamber[chamber_id] )
			)
		displayFolder: Tooltip
		lineageTag: aae31d77-2670-40eb-b966-ef3400b20de0

	/// The time window the tooltip numbers cover
	measure 'Tip Window' =
			IF (
			    HASONEVALUE ( dim_excursion[excursion_id] ),
			    "During excursion " & SELECTEDVALUE ( dim_excursion[excursion_label] ),
			    "All time"
			)
		displayFolder: Tooltip
		lineageTag: 5fccf790-20f8-4994-88e6-f75ea4d8c930

	/// Chamber-scope SPC alarms on the hovered chamber; within the excursion window when one excursion is selected
	measure 'Tip Alarms' =
			VAR OneExcursion = HASONEVALUE ( dim_excursion[excursion_id] )
			VAR FromTime = MIN ( dim_excursion[started_at] )
			VAR ToTime = MAX ( dim_excursion[ended_at] )
			RETURN
			    CALCULATE (
			        [Chamber Alarms],
			        TREATAS ( VALUES ( fct_root_cause_candidates[chamber_id] ), dim_chamber[chamber_id] ),
			        FILTER (
			            ALL ( fct_spc_alarms[measured_at] ),
			            NOT OneExcursion
			                || ( fct_spc_alarms[measured_at] >= FromTime
			                    && fct_spc_alarms[measured_at] < ToTime )
			        )
			    )
		formatString: #,0
		displayFolder: Tooltip
		lineageTag: 9a6b7ade-9adb-4b44-a803-cc24fc7bbdb9

		annotation PBI_FormatHint = {"isCustom":true}

	/// Wafers the hovered chamber processed; within the excursion window when one excursion is selected
	measure 'Tip Wafers' =
			VAR OneExcursion = HASONEVALUE ( dim_excursion[excursion_id] )
			VAR FromTime = MIN ( dim_excursion[started_at] )
			VAR ToTime = MAX ( dim_excursion[ended_at] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fct_wafer_steps[wafer_id] ),
			        TREATAS ( VALUES ( fct_root_cause_candidates[chamber_id] ), dim_chamber[chamber_id] ),
			        FILTER (
			            ALL ( fct_wafer_steps[track_in_at] ),
			            NOT OneExcursion
			                || ( fct_wafer_steps[track_in_at] >= FromTime
			                    && fct_wafer_steps[track_in_at] < ToTime )
			        )
			    )
		formatString: #,0
		displayFolder: Tooltip
		lineageTag: 49ae17e4-38c8-4e4f-8d72-a4258eb2e60f

		annotation PBI_FormatHint = {"isCustom":true}

	/// SPC alarm density on the hovered chamber, comparable across chambers
	measure 'Tip Alarms per 100 Wafers' = DIVIDE ( [Tip Alarms], [Tip Wafers] ) * 100
		formatString: 0.0
		displayFolder: Tooltip
		lineageTag: ad78f576-81ba-4d9a-a3a6-5b34712d6fa1

		annotation PBI_FormatHint = {"isCustom":true}

	/// Ground truth: excursions the simulator injected on the hovered chamber, all time
	measure 'Tip Injected Excursions' =
			CALCULATE (
			    COUNTROWS ( dim_excursion ),
			    REMOVEFILTERS ( dim_excursion ),
			    TREATAS ( VALUES ( fct_root_cause_candidates[chamber_id] ), dim_excursion[chamber_id] )
			)
		formatString: 0
		displayFolder: Tooltip
		lineageTag: 946d4a3e-4d8d-47c8-a3ca-5024443ba08d

		annotation PBI_FormatHint = {"isCustom":true}

	/// Median points from excursion start to the first alarm (chamber charts, detected, after the baseline)
	measure 'Detection Delay (points)' =
			CALCULATE (
			    MEDIAN ( fct_excursion_detection[delay_points] ),
			    fct_excursion_detection[scope] = "chamber",
			    fct_excursion_detection[detected] = TRUE (),
			    fct_excursion_detection[started_in_baseline] = FALSE ()
			)
		formatString: 0.0
		displayFolder: Process Control
		lineageTag: 41e60fce-ea97-4438-86d0-6751bd73f3c3

		annotation PBI_FormatHint = {"isCustom":true}

	/// Chance baseline: median points to the first alarm in a same-length window with no excursion
	measure 'Placebo Delay (points)' =
			CALCULATE (
			    MEDIAN ( fct_excursion_detection[placebo_delay_points] ),
			    fct_excursion_detection[scope] = "chamber",
			    fct_excursion_detection[monitored] = TRUE (),
			    fct_excursion_detection[started_in_baseline] = FALSE ()
			)
		formatString: 0.0
		displayFolder: Process Control
		lineageTag: ccc4439d-d359-40ea-b653-5da333b8a8b5

		annotation PBI_FormatHint = {"isCustom":true}

	/// Monitored excursions (after the baseline) that the chamber EWMA chart caught
	measure 'EWMA Detection Rate %' =
			VAR Eligible =
			    CALCULATETABLE (
			        fct_excursion_detection,
			        fct_excursion_detection[chart] = "ewma",
			        fct_excursion_detection[scope] = "chamber",
			        fct_excursion_detection[monitored] = TRUE (),
			        fct_excursion_detection[started_in_baseline] = FALSE ()
			    )
			RETURN
			    DIVIDE (
			        COUNTROWS ( FILTER ( Eligible, fct_excursion_detection[detected] ) ),
			        COUNTROWS ( Eligible )
			    )
		formatString: 0.0%
		displayFolder: Process Control
		lineageTag: eaff288e-50ee-4f33-9d7e-a04be8d87335

		annotation PBI_FormatHint = {"isCustom":true}

	/// Chamber-scope SPC alarms per 1,000 wafer steps: alarm density, fair across busy and quiet chambers
	measure 'Chamber Alarms per 1k Steps' = DIVIDE ( [Chamber Alarms], COUNTROWS ( fct_wafer_steps ) ) * 1000
		formatString: 0.0
		displayFolder: Process Control
		lineageTag: 3087a3ab-3ddf-4a5e-a61e-9f2e7d024f3a

		annotation PBI_FormatHint = {"isCustom":true}

	/// Yield of affected wafers minus same-window control wafers, in percentage points
	measure 'Excursion Yield Δ (pp)' = AVERAGE ( fct_excursion_impact[yield_delta_pct] )
		formatString: +0.00;-0.00;0.00
		displayFolder: Loss
		lineageTag: 69333520-f17a-46af-adbe-020c90507558

		annotation PBI_FormatHint = {"isCustom":true}

	column Column1
		dataType: string
		isHidden
		lineageTag: b54a5304-da85-41ea-a39f-d874a2d67af8
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				  Source

	annotation PBI_ResultType = Table

