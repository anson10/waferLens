# Copy to .env and adjust. docker-compose and the Python settings both read it.
POSTGRES_USER=waferlens
POSTGRES_PASSWORD=waferlens
POSTGRES_DB=waferlens
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://waferlens:waferlens@localhost:5432/waferlens

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Grafana reads the database as this read-only role (migration 0006).
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=grafana_reader

# MLflow tracking server + model registry (phase 5b).
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# FabEye wafer-map classifier (phase 5a); the key is sent as X-API-Key.
FABEYE_PORT=8000
FABEYE_URL=http://localhost:8000
FABEYE_API_KEY=change-me
PROMETHEUS_PORT=9090

# Redpanda (Kafka API) for real-time SPC (phase 6, compose profile `stream`).
KAFKA_PORT=19092
KAFKA_BOOTSTRAP=localhost:19092
